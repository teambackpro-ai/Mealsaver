# ---------------------------------------------------------------
# MealSaver – environment settings
# ---------------------------------------------------------------
# Copy this file to a new file called ".env" and fill in the values.
# The ".env" file is NOT uploaded to GitHub (it is listed in .gitignore).
#
# Everything starting with EXPO_PUBLIC_ is built INTO the app and can be
# read by anyone who downloads the app. Only put PUBLIC values here.
# NEVER put a secret key (Supabase "secret"/"service_role" key, AI API key)
# into this file. Secret keys live only on the server (Supabase).
# See docs/ENVIRONMENT.md for details.
# ---------------------------------------------------------------

# Optional: the app name shown to users. Default: MealSaver
EXPO_PUBLIC_APP_NAME=MealSaver

# Supabase project URL
# (Supabase dashboard > your project > "Connect" button, or Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co

# Supabase PUBLISHABLE key (starts with "sb_publishable_") or the legacy "anon" key.
# This key is designed to be public. Data is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Market: DE (Germany). UK will follow later.
EXPO_PUBLIC_DEFAULT_MARKET=DE
